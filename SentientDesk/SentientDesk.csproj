<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SentientDesk</RootNamespace>
    <AssemblyName>SentientDesk</AssemblyName>
    <Version>0.3.2</Version>
    <Product>SentientDesk</Product>
    <Description>Free desktop icon organizer for Windows — group desktop icons into movable fences you can own and extend.</Description>
    <StartupObject>SentientDesk.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- Avoid WinForms/Drawing types polluting WPF global usings -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Imaging" />
    <Using Remove="System.Drawing.Drawing2D" />
  </ItemGroup>

</Project>
